{
  "name": "fronted",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "oxlint --deny-warnings && node scripts/check-deps.mjs && node scripts/check-registry.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "verify-examples": "vite-node scripts/verify-examples.ts"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-query": "5.102.8",
    "antd": "6.6.2",
    "antd-mobile": "5.42.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.3",
    "zod": "^4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "1.81.0",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-node": "6.0.0"
  }
}
