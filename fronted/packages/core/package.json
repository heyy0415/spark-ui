{
  "name": "@strato-ui/core",
  "version": "0.1.0",
  "description": "Strato UI 渲染引擎：把后端下发的 UI Schema 渲染为白名单组件（antd 桌面 / antd-mobile 移动）。不发请求、不持有会话状态。",
  "type": "module",
  "sideEffects": [
    "./dist/style.css"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./style.css": "./dist/style.css"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "node ../../scripts/verify-pack.mjs"
  },
  "peerDependencies": {
    "@ant-design/icons": "^6",
    "antd": "^6",
    "antd-mobile": "^5",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4"
  },
  "devDependencies": {
    "@ant-design/icons": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "antd": "catalog:",
    "antd-mobile": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "zod": "catalog:"
  }
}
