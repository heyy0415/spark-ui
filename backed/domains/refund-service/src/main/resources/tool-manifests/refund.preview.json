{
  "toolId": "refund.preview", "version": "1.3.0", "domain": "refund",
  "name": "退款试算", "description": "试算退款金额与预计到账时间，不产生任何变更。",
  "protocol": "in-process",
  "inputSchema": { "type": "object", "additionalProperties": false, "required": ["orderId"],
    "properties": { "orderId": { "type": "string", "minLength": 1, "maxLength": 64 } } },
  "outputSchema": { "type": "object", "additionalProperties": false,
    "required": ["orderId", "amount", "currency", "estimatedDays"],
    "properties": { "orderId": { "type": "string" }, "amount": { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
      "currency": { "type": "string", "enum": ["CNY"] }, "estimatedDays": { "type": "integer", "minimum": 0 } } },
  "risk": { "level": "low", "sideEffect": false, "reversible": true, "confirmation": "never" },
  "authorization": { "permission": "refund:read" },
  "execution": { "timeoutMs": 3000, "maxRetries": 1, "idempotency": "none" },
  "owner": { "team": "refund-platform" }, "status": "active"
}
