{
  "name": "spark-harness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Harness 自用脚本的依赖。不是业务工程；spark-ui/ 与 spark-rooter/ 各自独立。",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "doctor": "node scripts/harness-doctor.mjs",
    "new-change": "node scripts/new-change.mjs",
    "check-contracts": "node scripts/check-contracts.mjs",
    "check-module-deps": "node scripts/check-module-deps.mjs",
    "check-rename": "node scripts/check-rename.mjs",
    "ci": "node scripts/ci.mjs",
