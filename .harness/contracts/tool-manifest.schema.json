{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spark-rooter.local/contracts/v1/tool-manifest.schema.json",
  "title": "ToolManifest",
  "description": "领域服务 → Tool Registry 的工具注册清单。toolId@version 一经注册不可变。description 视为不可信文本（≤ 500 字符，注入 prompt 前转义）。约束：risk.level=high ⇒ risk.confirmation=required；risk.sideEffect=true ⇒ execution.idempotency=required。",
  "type": "object",
  "additionalProperties": false,
  "required": ["toolId", "version", "domain", "name", "description", "protocol", "inputSchema", "outputSchema", "risk", "authorization", "execution", "owner", "status"],
  "properties": {
    "toolId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$",
      "description": "形如 {domain}.{resource}.{verb}，小写点分"
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "semver，已发布不可变" },
    "domain": { "type": "string", "pattern": "^[a-z][a-z0-9]*$", "maxLength": 32 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80, "description": "用户可读名称，用于 tool.selected.displayName" },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "protocol": { "type": "string", "enum": ["in-process", "http", "mcp"], "description": "in-process = 领域服务与内核同进程（单体内嵌）；http = 领域服务为独立进程（微服务），必须给出 provider 坐标；mcp 保留未实现，Registry 注册时拒绝" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "description": "远程提供方坐标，仅 protocol=http 时出现（protocol=in-process 时禁止出现）。baseUrl 允许 http:// 以便内网部署与本地联调，但传输未加密，生产应使用 HTTPS 或 mTLS；使用 http:// 时 hub 启动会 WARN。",
      "required": ["serviceName"],
      "properties": {
        "serviceName": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$", "description": "逻辑服务名，与调用方认证密钥绑定（防服务 A 注册服务 B 的工具）" },
        "baseUrl": { "type": "string", "pattern": "^https?://[^\\s]+$", "description": "可选；缺省时由宿主 ProviderEndpointResolver 按 serviceName 解析（接注册中心场景）。与 serviceName 解析结果均缺失时注册失败" },
        "instanceId": { "type": "string", "maxLength": 128, "description": "可选；仅用于审计与排障（哪个实例注册的），不参与寻址" }
      }
    },
    "inputSchema": { "$ref": "#/$defs/jsonSchemaObject" },
    "outputSchema": { "$ref": "#/$defs/jsonSchemaObject" },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "sideEffect", "reversible", "confirmation"],
      "properties": {
        "level": { "type": "string", "enum": ["low", "medium", "high"] },
        "sideEffect": { "type": "boolean" },
        "reversible": { "type": "boolean" },
        "confirmation": { "type": "string", "enum": ["never", "required"] }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "description": "内核不做鉴权，本节点仅供宿主 ToolAccessPolicy 参考；@SparkTool 推导的 Manifest 为空对象 {}",
      "properties": {
        "permission": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$", "description": "可选，如 refund:create；宿主自定义语义" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "maxRetries", "idempotency"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "maxRetries": { "type": "integer", "minimum": 0, "maximum": 5 },
        "idempotency": { "type": "string", "enum": ["none", "required"] }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team"],
      "properties": {
        "team": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "status": { "type": "string", "enum": ["draft", "canary", "active", "deprecated"], "description": "只有 active / canary 可被 Registry 搜索发现" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "risk": { "type": "object", "properties": { "level": { "const": "high" } }, "required": ["level"] } },
        "required": ["risk"]
      },
      "then": {
        "type": "object",
        "properties": { "risk": { "type": "object", "properties": { "confirmation": { "const": "required" } } } }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "risk": { "type": "object", "properties": { "sideEffect": { "const": true } }, "required": ["sideEffect"] } },
        "required": ["risk"]
      },
      "then": {
        "type": "object",
        "properties": { "execution": { "type": "object", "properties": { "idempotency": { "const": "required" } } } }
      }
    },
    {
      "$comment": "protocol=http ⇒ provider 必填（Gateway 需要坐标才能寻址）。then 里重复声明 provider 的 properties 是 ajv strictRequired 的要求：required 的属性必须在同一 schema 对象内可见",
      "if": {
        "type": "object",
        "properties": { "protocol": { "const": "http" } },
        "required": ["protocol"]
      },
      "then": {
        "type": "object",
        "required": ["provider"],
        "properties": { "provider": { "type": "object" } }
      }
    },
    {
      "$comment": "protocol=in-process ⇒ provider 禁止出现（单体形态无远程坐标概念，出现即配置错误）",
      "if": {
        "type": "object",
        "properties": { "protocol": { "const": "in-process" } },
        "required": ["protocol"]
      },
      "then": { "type": "object", "not": { "required": ["provider"] } }
    }
  ],
  "$defs": {
    "jsonSchemaObject": {
      "description": "内嵌的 JSON Schema（对象类型），由 Gateway 用来校验工具输入 / 输出",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "object" }
      }
    }
  }
}
