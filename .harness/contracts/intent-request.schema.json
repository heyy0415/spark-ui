{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spark-rooter.local/contracts/v1/intent-request.schema.json",
  "title": "IntentRequest",
  "description": "前端 → Agent Runtime，POST /agent/runs 请求体。用户自然语言意图 + 页面上下文 + 客户端能力。pageContext 为不可信输入，后端必须重新鉴权；principal 来自请求头而非 body。",
  "type": "object",
  "additionalProperties": false,
  "required": ["conversationId", "message", "clientCapabilities"],
  "properties": {
    "conversationId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "pageContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page"],
      "properties": {
        "page": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9-]+$" },
        "selectedEntity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z]+$" },
            "id": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      }
    },
    "clientCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uiSchemaVersion", "components"],
      "properties": {
        "uiSchemaVersion": { "const": "1.0" },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "description": "客户端可渲染的组件名；Runtime 只生成交集内的组件"
        }
      }
    }
  }
}
