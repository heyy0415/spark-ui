{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spark-rooter.local/contracts/v1/tool-search.schema.json",
  "title": "ToolSearch",
  "description": "Agent Runtime ↔ Tool Registry，POST /internal/tool-registry/search 的请求与响应对。Registry 先按 tenant / permission / status / 风险策略过滤；响应项只含六个字段（agent-safety §2），禁止泄露内部地址、凭据、Owner。",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "response"],
  "properties": {
    "request": { "$ref": "#/$defs/request" },
    "response": { "$ref": "#/$defs/response" }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "principal"],
      "properties": {
        "domain": { "type": "string", "pattern": "^[a-z][a-z0-9]*$", "maxLength": 32 },
        "intent": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64, "description": "可选的意图提示，仅用于排序" },
        "principal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["userId", "tenantId"],
          "properties": {
            "userId": { "type": "string", "minLength": 1, "maxLength": 64 },
            "tenantId": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entityType": { "type": "string", "pattern": "^[a-z]+$", "maxLength": 32 }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools"],
      "properties": {
        "tools": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/toolCandidate" }
        }
      }
    },
    "toolCandidate": {
      "description": "返回给模型的候选工具。字段集合固定为六个，不得增加。",
      "type": "object",
      "additionalProperties": false,
      "required": ["toolId", "version", "description", "inputSchema", "riskLevel", "confirmation"],
      "properties": {
        "toolId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*){1,3}$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "inputSchema": { "type": "object", "required": ["type"], "properties": { "type": { "const": "object" } } },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high"] },
        "confirmation": { "type": "string", "enum": ["never", "required"] }
      }
    }
  }
}
