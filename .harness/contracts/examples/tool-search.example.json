{
  "request": {
    "domain": "refund",
    "intent": "create_refund",
    "context": { "entityType": "order" }
  },
  "response": {
    "tools": [
      {
        "toolId": "refund.eligibility.check",
        "version": "1.2.0",
        "description": "检查指定订单当前是否满足退款条件，返回是否可退、可退金额与不可退原因。只读，无副作用。",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["orderId"],
          "properties": { "orderId": { "type": "string", "minLength": 1, "maxLength": 64 } }
        },
        "riskLevel": "low",
        "confirmation": "never"
      },
      {
        "toolId": "refund.preview",
        "version": "1.3.0",
        "description": "试算退款金额与预计到账时间，不产生任何变更。",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["orderId"],
          "properties": { "orderId": { "type": "string", "minLength": 1, "maxLength": 64 } }
        },
        "riskLevel": "low",
        "confirmation": "never"
      },
      {
        "toolId": "refund.create",
        "version": "2.1.0",
        "description": "为满足条件的订单创建退款单。有副作用、不可逆，必须经用户确认，调用需携带幂等键。",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["orderId", "amount", "reason"],
          "properties": {
            "orderId": { "type": "string", "minLength": 1, "maxLength": 64 },
            "amount": { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
            "reason": { "type": "string", "enum": ["DAMAGED", "NOT_RECEIVED", "CHANGED_MIND"] }
          }
        },
        "riskLevel": "high",
        "confirmation": "required"
      },
      {
        "toolId": "refund.status.get",
        "version": "1.0.0",
        "description": "查询订单下的退款单列表与状态。只读。",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["orderId"],
          "properties": { "orderId": { "type": "string", "minLength": 1, "maxLength": 64 } }
        },
        "riskLevel": "low",
        "confirmation": "never"
      }
    ]
  }
}
