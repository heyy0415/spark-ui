{
  "toolId": "order.detail.get",
  "version": "1.0.0",
  "domain": "order",
  "name": "查询订单详情",
  "description": "invalid: provider.serviceName 含大写与下划线，不合 ^[a-z][a-z0-9-]{1,62}$ —— 服务名要与认证密钥绑定，格式必须收紧。",
  "protocol": "http",
  "provider": {
    "serviceName": "Order_Service",
    "baseUrl": "http://order-service.internal:8080",
    "instanceId": "order-service-7d9f4b8c6-x2klm"
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "orderId"
    ],
    "properties": {
      "orderId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "orderId",
      "status",
      "totalAmount",
      "currency"
    ],
    "properties": {
      "orderId": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "totalAmount": {
        "type": "string",
        "pattern": "^-?\\d+(\\.\\d{1,2})?$"
      },
      "currency": {
        "type": "string",
        "enum": [
          "CNY"
        ]
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "risk": {
    "level": "low",
    "sideEffect": false,
    "reversible": true,
    "confirmation": "never"
  },
  "authorization": {},
  "execution": {
    "timeoutMs": 3000,
    "maxRetries": 1,
    "idempotency": "none"
  },
  "owner": {
    "team": "order-platform"
  },
  "status": "active"
}
