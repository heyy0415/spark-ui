{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strato.local/contracts/v1/ui-schema.schema.json",
  "title": "UiSchema",
  "description": "Runtime → 前端。声明式 UI 描述：前端只渲染 components[].type 白名单内的组件，actions[] 通过 actionId 提交；confirmationToken 为不透明字符串，前端只回传不解析。禁止出现 URL / HTML / 脚本字段。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "screenId",
    "title",
    "components",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "description": "UI Schema 协议版本"
    },
    "screenId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "components": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "componentType": {
      "description": "前端白名单组件。新增 = 改本 enum + 前端注册表 + 后端生成逻辑，三处同一 change。",
      "type": "string",
      "enum": [
        "Form",
        "Card",
        "Table",
        "ResultCard",
        "ConfirmationCard",
        "OrderCard",
        "RefundConfirmCard",
        "OrderList",
        "ProductList",
        "LogisticsTimeline"
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "props"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9-]+$"
        },
        "type": {
          "$ref": "#/$defs/componentType"
        },
        "props": {
          "type": "object",
          "description": "组件专属属性，自由 JSON；Form / OrderList / ProductList / LogisticsTimeline 四类由本 Schema 的 if/then 约束，其余各组件 props 的前端约束在 @strato-ui/core（fronted/packages/core/src/registry/types.ts）中定义"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "Form"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "props": {
                "$ref": "#/$defs/formProps"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "OrderList"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "props": {
                "$ref": "#/$defs/orderListProps"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "ProductList"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "props": {
                "$ref": "#/$defs/productListProps"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "LogisticsTimeline"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "props": {
                "$ref": "#/$defs/logisticsTimelineProps"
              }
            }
          }
        }
      ]
    },
    "formProps": {
      "type": "object",
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/formField"
          }
        }
      }
    },
    "formField": {
      "description": "Form 字段声明。确认时 formData 只允许包含这里声明的 name（agent-safety §3）。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "label"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "select",
            "number"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "style"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9-]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "submit",
            "cancel"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "style": {
          "type": "string",
          "enum": [
            "default",
            "primary",
            "danger"
          ]
        },
        "confirmationToken": {
          "type": "string",
          "minLength": 16,
          "maxLength": 256,
          "description": "后端签发的不透明 Token，绑定 runId / actionId / argsDigest / 过期时间，一次性"
        }
      }
    },
    "iconName": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$",
      "description": "缩略图为白名单图标名（前端映射到图标库），不是 URL"
    },
    "money": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d{1,2})?$",
      "description": "金额，元，两位小数字符串"
    },
    "inlineAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "intent"
      ],
      "description": "行内快捷指令：前端点击后把 intent 原样作为一条新的用户消息发送，走完整的路由 / 候选 / 校验 / 确认链路；不是命令、不是 URL、不带 token。",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?!.*(://|<)).*$"
        }
      }
    },
    "orderListItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "productName",
        "quantity",
        "amount",
        "currency",
        "status",
        "createdAt",
        "actions"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "thumbnail": {
          "$ref": "#/$defs/iconName"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "amount": {
          "$ref": "#/$defs/money"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "actions": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/inlineAction"
          }
        }
      }
    },
    "orderListProps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "total"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/orderListItem"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "emptyText": {
          "type": "string",
          "maxLength": 120,
          "description": "items 为空时显示；total > items.length 时作为列表底部说明"
        }
      }
    },
    "productListItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId",
        "title",
        "price",
        "currency",
        "stock",
        "category",
        "actions"
      ],
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "price": {
          "$ref": "#/$defs/money"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "stock": {
          "type": "integer",
          "minimum": 0
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "thumbnail": {
          "$ref": "#/$defs/iconName"
        },
        "actions": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/inlineAction"
          }
        }
      }
    },
    "productListProps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "total"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/productListItem"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "emptyText": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "logisticsEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "location",
        "description"
      ],
      "properties": {
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "location": {
          "type": "string",
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "logisticsTimelineProps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "carrier",
        "trackingNo",
        "status",
        "events"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "carrier": {
          "type": "string",
          "maxLength": 32
        },
        "trackingNo": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "含 NOT_SHIPPED（无物流，events 为空）"
        },
        "events": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/logisticsEvent"
          }
        }
      }
    }
  }
}
