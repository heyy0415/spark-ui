{
  "name": "spark-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Spark 唯一前端应用：一个 chat 页面，接入 @spark-ui/core 渲染引擎。",
  "scripts": {
    "predev": "node ./scripts/ensure-core-dist.mjs",
    "prebuild": "node ./scripts/ensure-core-dist.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@spark-ui/core": "workspace:*",
    "antd": "catalog:",
    "antd-mobile": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "7.18.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
