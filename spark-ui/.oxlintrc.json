{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/.verify-pack/**"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports"
      }
    ],
    "typescript/consistent-type-definitions": ["error", "interface"],
    "typescript/no-non-null-assertion": "error",
    "typescript/no-namespace": "error",
    "typescript/prefer-as-const": "error",
    "typescript/array-type": [
      "error",
      {
        "default": "array"
      }
    ],
    "typescript/no-inferrable-types": "error",
    "typescript/ban-ts-comment": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/jsx-key": "error",
    "react/jsx-no-useless-fragment": "warn",
    "react/react-in-jsx-scope": "off",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["__dirname", "__filename"]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["../../*"],
            "message": "Use path aliases (@shared/*, @entities/*, ...) instead of ../../ paths."
          },
          {
            "group": [
              "@features/*/api/*",
              "@features/*/model/*",
              "@features/*/ui/*",
              "@entities/*/api/*",
              "@entities/*/model/*",
              "@entities/*/ui/*"
            ],
            "message": "Import slice public API via its index.ts (e.g. @entities/agent-run)."
          },
          {
            "group": ["antd", "antd/*", "antd-mobile", "antd-mobile/*", "@ant-design/*"],
            "message": "UI libraries may only be imported inside packages/core/src/components/** and packages/core/src/theme/**. Apps use @spark-ui/core."
          },
          {
            "group": [
              "@spark-ui/core/src",
              "@spark-ui/core/src/*",
              "@spark-ui/core/dist",
              "@spark-ui/core/dist/*"
            ],
            "message": "Import @spark-ui/core via a declared entry: '.', './client', './react' or './style.css'. Reaching into src/ or dist/ bypasses the package's public API."
          },
          {
            "group": ["@contracts/*"],
            "message": "@contracts/* (example JSON) may only be imported from apps/chat/src/pages/** or scripts/**."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["scripts/**/*.{mjs,ts}", "apps/*/scripts/**/*.mjs", "**/vite.config.ts"],
      "env": {
        "node": true
      },
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["e2e/**/*.ts", "playwright.config.ts"],
      "env": {
        "node": true,
        "browser": true
      },
      "rules": {
        "no-console": "off",
        "no-underscore-dangle": "off"
      }
    },
    {
      "files": ["packages/core/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["antd", "antd/*", "antd-mobile", "antd-mobile/*", "@ant-design/*"],
                "message": "UI libraries may only be imported inside packages/core/src/components/** and packages/core/src/theme/**. Apps use @spark-ui/core."
              },
              {
                "group": [
                  "@spark-ui/core/src",
                  "@spark-ui/core/src/*",
                  "@spark-ui/core/dist",
                  "@spark-ui/core/dist/*"
                ],
                "message": "Import @spark-ui/core via a declared entry: '.', './client', './react' or './style.css'. Reaching into src/ or dist/ bypasses the package's public API."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/core/src/components/**", "packages/core/src/theme/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@spark-ui/core/src",
                  "@spark-ui/core/src/*",
                  "@spark-ui/core/dist",
                  "@spark-ui/core/dist/*"
                ],
                "message": "Import @spark-ui/core via a declared entry: '.', './client', './react' or './style.css'. Reaching into src/ or dist/ bypasses the package's public API."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/chat/src/pages/**", "scripts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../../*"],
                "message": "Use path aliases (@shared/*, @entities/*, ...) instead of ../../ paths."
              },
              {
                "group": [
                  "@features/*/api/*",
                  "@features/*/model/*",
                  "@features/*/ui/*",
                  "@entities/*/api/*",
                  "@entities/*/model/*",
                  "@entities/*/ui/*"
                ],
                "message": "Import slice public API via its index.ts (e.g. @entities/agent-run)."
              },
              {
                "group": ["antd", "antd/*", "antd-mobile", "antd-mobile/*", "@ant-design/*"],
                "message": "UI libraries may only be imported inside packages/core/src/components/** and packages/core/src/theme/**. Apps use @spark-ui/core."
              },
              {
                "group": [
                  "@spark-ui/core/src",
                  "@spark-ui/core/src/*",
                  "@spark-ui/core/dist",
                  "@spark-ui/core/dist/*"
                ],
                "message": "Import @spark-ui/core via a declared entry: '.', './client', './react' or './style.css'. Reaching into src/ or dist/ bypasses the package's public API."
              }
            ]
          }
        ]
      }
    }
  ]
}
