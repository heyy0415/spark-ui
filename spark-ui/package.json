{
  "name": "spark-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Spark UI 前端 workspace 根：packages/core 可发包引擎 + apps/chat 唯一应用。无业务代码。",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build:core": "pnpm --filter @spark-ui/core build",
    "build:chat": "pnpm --filter spark-chat build",
    "build": "pnpm build:core && pnpm build:chat",
    "dev": "pnpm --filter spark-chat dev",
    "preview": "pnpm --filter spark-chat preview",
    "typecheck": "pnpm --filter @spark-ui/core exec tsc -p tsconfig.json --noEmit && pnpm --filter spark-chat exec tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings && node scripts/check-deps.mjs && node scripts/check-registry.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify-examples": "vite-node -c apps/chat/vite.config.ts scripts/verify-examples.ts",
    "verify-pack": "node scripts/verify-pack.mjs",
    "ci": "pnpm build:core && pnpm typecheck && pnpm test && pnpm lint && pnpm format:check && pnpm verify-examples && pnpm verify-transport && pnpm build:chat && pnpm verify-pack",
    "verify-transport": "vite-node -c apps/chat/vite.config.ts scripts/verify-transport.ts",
    "test": "pnpm -r run test",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@spark-ui/core": "workspace:*",
    "@types/node": "^20.19.0",
    "es-module-lexer": "^2.3.2",
    "oxlint": "1.81.0",
    "prettier": "^3.9.6",
    "typescript": "catalog:",
    "vite-node": "6.0.0"
  }
}
