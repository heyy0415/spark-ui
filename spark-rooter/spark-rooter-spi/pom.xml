<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>spark-rooter-spi</artifactId>
  <name>spark-rooter-spi</name>
  <properties>
    <!-- 共享契约层取两边下限：provider 可能跑在 JDK 17 的业务服务里（企业存量大量停在 17），
         而 21 字节码（major 65）在 17 上会 UnsupportedClassVersionError。hub 侧模块仍为 21。 -->
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <!-- SeedLoader 的 Instant 反序列化；仍是 JDK / Jackson，无 Spring -->
    <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jsr310</artifactId></dependency>
    <!-- 单元测试：版本由 spring-boot-dependencies 管理 -->
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
