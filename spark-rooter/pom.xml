<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.sparkrooter</groupId>
  <artifactId>spark-rooter-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>spark-rooter-parent</name>

  <modules>
    <module>spark-rooter-spi</module>
    <module>spark-rooter-contracts</module>
    <module>spark-rooter-registry</module>
    <module>spark-rooter-gateway</module>
    <module>spark-rooter-runtime</module>
    <module>spark-rooter-web-mvc</module>
    <module>spark-rooter-spring-boot-starter</module>
    <!-- 可选：hub 多副本时把四个状态存储换成 Redis；平台模块不得反向依赖它 -->
    <module>spark-rooter-redis</module>
    <!-- 微服务形态：领域服务侧的薄 starter（JDK 17 下限，不含 Spring AI / runtime / gateway） -->
    <module>spark-provider-spring-boot-starter</module>
    <!-- examples/* 在下方 examples profile 里（默认激活）：别人 `mvn deploy -P '!examples'` 只发平台 artifact -->
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.5.16</spring-boot.version>
    <spring-ai.version>1.1.8</spring-ai.version>
    <networknt.version>1.5.9</networknt.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${networknt.version}</version>
      </dependency>
      <!-- 内部模块 -->
      <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-spi</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-contracts</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.sparkrooter</groupId><artifactId>demo-support</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-registry</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-gateway</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-runtime</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-web-mvc</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-spring-boot-starter</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.sparkrooter</groupId><artifactId>demo-support</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.sparkrooter</groupId><artifactId>order-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.sparkrooter</groupId><artifactId>product-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.sparkrooter</groupId><artifactId>aftersale-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.sparkrooter</groupId><artifactId>refund-service</artifactId><version>${project.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <!-- 单元测试（JUnit 5）随 verify 执行，是后端质量门禁的一部分（backend-standard §1） -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.4</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <!-- 取 maven.compiler.release 属性，子模块可覆盖：共享契约层（spi / contracts）降为 17
               以便 provider 跑在 JDK 17 的业务服务里；hub 侧模块继承默认 21 -->
          <release>${maven.compiler.release}</release>
          <parameters>true</parameters>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
            <!-- Spring / Jackson 的注解处理器在 -Xlint:all 下会报 processing 警告，属第三方噪音，单独关闭 -->
            <arg>-Xlint:-processing</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>enforce-jdk</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.46.1</version>
        <configuration>
          <java>
            <googleJavaFormat/>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals><goal>check</goal></goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!--
      示例领域与支撑模块。默认激活（本仓 ci / e2e 都要它们），但独立成 profile 是为了自发包：
      `mvn deploy -P '!examples'` 只推 8 个平台 artifact，不把 order-service 这类示例领域塞进别人的私服。
      check-module-deps 守：examples/* 不得回到顶层 <modules>。
    -->
    <profile>
      <id>examples</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <modules>
        <module>examples/demo-support</module>
        <module>examples/domains/order-service</module>
        <module>examples/domains/product-service</module>
        <module>examples/domains/aftersale-service</module>
        <module>examples/domains/refund-service</module>
      </modules>
    </profile>
    <!--
      发布产物补全：sources / javadoc jar。默认不激活——日常构建不需要，javadoc 生成还慢。
      别人发到私服时 `mvn deploy -P release,'!examples'`；Maven Central 强制要求这两个 jar，私服通常不强制。
      doclint 关掉：Spring / Jackson 注解与中文 javadoc 里的符号会触发大量无意义告警。
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
              <failOnError>false</failOnError>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
