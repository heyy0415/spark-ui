<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.sparkrooter</groupId>
    <artifactId>spark-rooter-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>spark-rooter-contracts</artifactId>
  <name>spark-rooter-contracts</name>

  <properties>
    <!-- 共享契约层取两边下限：provider 可能跑在 JDK 17 的业务服务里（企业存量大量停在 17），
         而 21 字节码（major 65）在 17 上会 UnsupportedClassVersionError。hub 侧模块仍为 21。 -->
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-spi</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <!-- PlatformMapper 显式注册：时间不用时间戳；record 组件 Optional<T> 缺键 → empty -->
    <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jsr310</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jdk8</artifactId></dependency>
    <dependency><groupId>com.networknt</groupId><artifactId>json-schema-validator</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
    <dependency><groupId>jakarta.validation</groupId><artifactId>jakarta.validation-api</artifactId></dependency>
    <!-- 仅 infra/selfcheck 用到 @Component；domain / model 包不得 import Spring（check-module-deps 守护） -->
    <dependency><groupId>org.springframework</groupId><artifactId>spring-context</artifactId></dependency>
    <!-- 单元测试：版本由 spring-boot-dependencies 管理 -->
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
  </dependencies>

  <!-- 契约真源在 .harness/contracts/；本模块 src/main/resources/contracts/ 是 sync-contracts 生成的副本（见 CONTRACTS.md），
       check-contracts 门禁校验二者一致。不再用相对路径引用仓库外目录，模块可独立构建 / 发布。 -->
</project>
