<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.sparkrooter</groupId>
    <artifactId>spark-rooter-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>spark-rooter-spring-boot-starter</artifactId>
  <name>spark-rooter-spring-boot-starter</name>
  <!-- 宿主唯一引入坐标：AutoConfiguration.imports + 属性类 + 全部平台 Bean 的 @ConditionalOnMissingBean 装配（spec §2.3）。不依赖包扫描。 -->
  <dependencies>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-spi</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-contracts</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-runtime</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-registry</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-gateway</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-web-mvc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-autoconfigure</artifactId></dependency>
    <!-- AopUtils / ClassUtils：经代理调用 @SparkTool 方法，让宿主方法级切面生效 -->
    <dependency><groupId>org.springframework</groupId><artifactId>spring-aop</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-aop</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jsr310</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
  </dependencies>
</project>
