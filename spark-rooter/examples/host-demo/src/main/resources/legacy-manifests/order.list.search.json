{
  "toolId": "order.list.search",
  "version": "1.1.0",
  "domain": "order",
  "name": "搜索订单",
  "description": "按状态筛选当前租户下的订单列表，按下单时间倒序（最新在前），默认返回前 20 条（limit 最大 50）；已删除订单不返回。total 为筛选后总数。只读，无副作用。",
  "protocol": "in-process",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "PAID",
          "SHIPPED",
          "COMPLETED",
          "REFUNDED",
          "CANCELLED"
        ]
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 20
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "items",
      "total"
    ],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "orderId",
            "productId",
            "productName",
            "quantity",
            "amount",
            "currency",
            "status",
            "createdAt"
          ],
          "properties": {
            "orderId": {
              "type": "string"
            },
            "productId": {
              "type": "string"
            },
            "productName": {
              "type": "string"
            },
            "thumbnail": {
              "type": "string"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            },
            "amount": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d{1,2})?$"
            },
            "currency": {
              "type": "string",
              "enum": [
                "CNY"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "PAID",
                "SHIPPED",
                "COMPLETED",
                "REFUNDED",
                "CANCELLED"
              ]
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      },
      "total": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "risk": {
    "level": "low",
    "sideEffect": false,
    "reversible": true,
    "confirmation": "never"
  },
  "authorization": {
    "permission": "order:read"
  },
  "execution": {
    "timeoutMs": 3000,
    "maxRetries": 1,
    "idempotency": "none"
  },
  "owner": {
    "team": "order-platform"
  },
  "status": "active"
}
