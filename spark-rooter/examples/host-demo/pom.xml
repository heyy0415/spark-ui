<?xml version="1.0" encoding="UTF-8"?>
<!--
  示例宿主：独立 Maven 工程（不是 spark-rooter-parent 的子模块），演示「任何 Spring Boot 服务引入 starter 即可用」。
  依赖来自本地仓：先在 spark-rooter/ 执行 ./mvnw -q install，再在此目录 mvn -q package（首次在线拉插件）/ mvn -q -o package。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>com.example</groupId>
  <artifactId>host-demo</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>host-demo</name>
  <properties>
    <java.version>21</java.version>
    <spark-rooter.version>0.1.0-SNAPSHOT</spark-rooter.version>
  </properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-aop</artifactId></dependency>
    <!-- 宿主唯一需要的 spark 坐标 -->
    <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-spring-boot-starter</artifactId><version>${spark-rooter.version}</version></dependency>
    <!-- 四个示例领域（@SparkTool 形态）+ 示例用户上下文 -->
    <dependency><groupId>com.sparkrooter</groupId><artifactId>order-service</artifactId><version>${spark-rooter.version}</version></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>product-service</artifactId><version>${spark-rooter.version}</version></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>aftersale-service</artifactId><version>${spark-rooter.version}</version></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>refund-service</artifactId><version>${spark-rooter.version}</version></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>demo-support</artifactId><version>${spark-rooter.version}</version></dependency>
  </dependencies>
  <build>
    <finalName>host-demo</finalName>
    <plugins>
      <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
    </plugins>
  </build>
</project>
