<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>app</artifactId>
  <name>app</name>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <!-- T08 验收：主类包 com.example.tmp、不扫 com.sparkrooter，只靠 starter 自动装配（T09b 删除本模块） -->
    <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-spring-boot-starter</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>order-service</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>product-service</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>aftersale-service</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>refund-service</artifactId></dependency>
  </dependencies>
  <build>
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions><execution><goals><goal>repackage</goal></goals></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
