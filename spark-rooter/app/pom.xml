<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>app</artifactId>
  <name>app</name>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-spi</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-contracts</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-registry</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-gateway</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-runtime</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>spark-rooter-web-mvc</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>order-service</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>product-service</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>aftersale-service</artifactId></dependency>
    <dependency><groupId>com.sparkrooter</groupId><artifactId>refund-service</artifactId></dependency>
  </dependencies>
  <build>
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions><execution><goals><goal>repackage</goal></goals></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
